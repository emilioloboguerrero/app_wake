# Local emulator env for sandbox-mode payment testing.
# Copy to functions/.env.local (gitignored). Never commit real secrets.
#
# Workflow:
#   1) Generate sandbox creds at https://www.mercadopago.com/developers/panel
#      - Test users: create one buyer + one seller
#      - Use the seller's TEST- access token below
#   2) Run emulator:           firebase emulators:start --only functions,firestore,auth
#   3) Tunnel the webhook:     ngrok http 5001
#   4) Set WAKE_NOTIFICATION_URL_OVERRIDE to your ngrok webhook URL (see below).
#   5) Pay with MP test cards (cardholder APRO = approved, OTHE = rejected, etc.).

# ── MercadoPago sandbox ──
# Sandbox token (starts with TEST-). Production token starts with APP_USR-.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx

# Any string for local. In MP test app config, set the same value as the
# webhook secret. Or set WAKE_DEV_SKIP_WEBHOOK_HMAC=1 below to skip the check.
MERCADOPAGO_WEBHOOK_SECRET=local-test-secret

# ── Webhook tunnel (per-subscription override) ──
# When set, the /payments/subscription endpoint passes notification_url to MP
# so MP delivers webhooks for THIS subscription to your ngrok URL instead of
# the production webhook. Leave empty in production.
# Format: https://<ngrok-id>.ngrok.io/wolf-20b8b/us-central1/api/payments/webhook
# WAKE_NOTIFICATION_URL_OVERRIDE=

# ── Webhook HMAC bypass (emulator-only) ──
# Skips signature validation. Only honored when FUNCTIONS_EMULATOR=true (set
# automatically by firebase emulators:start), so it cannot be enabled in prod.
# WAKE_DEV_SKIP_WEBHOOK_HMAC=1

# ── Other secrets the emulator will probably ask for ──
# These don't need real values for payment testing — leave as TEST or empty.
FATSECRET_CLIENT_ID=test
FATSECRET_CLIENT_SECRET=test
RESEND_API_KEY=re_test_xxxxxxxxxxxxxxxx
